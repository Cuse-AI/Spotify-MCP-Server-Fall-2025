# Midden API Keys
# Copy this to .env and fill in your keys

# YouTube API (required for scraper)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_API_KEY_2=optional_second_key_for_rotation
YOUTUBE_API_KEY_3=optional_third_key_for_rotation

# Spotify API (optional - for getting spotify IDs)
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Claude API (for Ananki analysis - used in pipeline stage 3)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
